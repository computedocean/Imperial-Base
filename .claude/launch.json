{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "backend",
      "runtimeExecutable": "backend/.venv/Scripts/python.exe",
      "runtimeArgs": [
        "-m",
        "uvicorn",
        "--factory",
        "app.main:create_app",
        "--app-dir",
        "backend",
        "--host",
        "127.0.0.1",
        "--port",
        "8742",
        "--reload",
        "--reload-dir",
        "backend/app",
        "--no-proxy-headers",
        "--ws-max-size",
        "65536"
      ],
      "port": 8742
    },
    {
      "name": "frontend",
      "runtimeExecutable": "cmd",
      "runtimeArgs": [
        "/c",
        "cd frontend && npx vite --port 5273 --host 127.0.0.1"
      ],
      "port": 5273
    },
    {
      "name": "backend-qa",
      "runtimeExecutable": "cmd",
      "runtimeArgs": [
        "/c",
        "set IMPERIAL_DB=%TEMP%\\imperial-qa.db&& backend\\.venv\\Scripts\\python.exe -m uvicorn --factory app.main:create_app --app-dir backend --host 127.0.0.1 --port 8743 --no-proxy-headers --ws-max-size 65536"
      ],
      "port": 8743
    },
    {
      "name": "frontend-qa",
      "runtimeExecutable": "cmd",
      "runtimeArgs": [
        "/c",
        "set IMPERIAL_BACKEND=http://127.0.0.1:8743&& cd frontend && npx vite --port 5274 --host 127.0.0.1"
      ],
      "port": 5274
    }
  ]
}
