{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "backend",
      "runtimeExecutable": "backend/.venv/Scripts/python.exe",
      "runtimeArgs": [
        "-m",
        "uvicorn",
        "--factory",
        "app.main:create_app",
        "--app-dir",
        "backend",
        "--host",
        "127.0.0.1",
        "--port",
        "8742",
        "--reload",
        "--reload-dir",
        "backend/app"
      ],
      "port": 8742
    },
    {
      "name": "frontend",
      "runtimeExecutable": "cmd",
      "runtimeArgs": [
        "/c",
        "cd frontend && set IMPERIAL_BACKEND=http://127.0.0.1:8743&& npx vite --port 5273 --host 127.0.0.1"
      ],
      "port": 5273
    }
  ]
}